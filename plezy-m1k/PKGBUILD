# Contributor: Jonathan Grotelüschen <tippfehlr@archlinux.org>
# Contributor: Mark Wagie <mark dot wagie at proton dot me>
# Contributor: Aburady <accounts@aburady.com>

pkgname=plezy-m1k
pkgver=2.20.154
pkgrel=1
pkgdesc="A modern Plex and Jellyfin client, ironashram fork with the TrueHD passthrough and Live TV fixes"
arch=('x86_64')
url="https://github.com/ironashram/plezy"
license=('GPL-3.0-or-later')
# The bundle ships its own libmpv and everything it links, so there is no mpv
# dependency; this list is the host set the upstream packaging declares.
depends=(
  'gtk3' 'libepoxy' 'alsa-lib' 'libevdev' 'glib2' 'wayland' 'libglvnd'
  'libva' 'libdrm' 'mesa' 'libx11' 'libxext' 'libxcb' 'hicolor-icon-theme'
)
provides=("plezy=$pkgver")
conflicts=('plezy')
_tag=$pkgver
source=(
  "$pkgname-$pkgver.tar.gz::$url/releases/download/$_tag/plezy-linux-x64.tar.gz"
  "$url/raw/$_tag/linux/packaging/com.edde746.plezy.desktop"
  "$url/raw/$_tag/assets/plezy.svg"
  "$url/raw/$_tag/assets/plezy.png"
)
sha256sums=('521c0e67e2e118aa79ab42f5759ae3b32befbfcaec7038faaa24e8594aa35750'
            'fe0562829eedf1ad979e4a26e936a3e7e133c0360a2418a39d6b686f4b64e4b8'
            '0ae31068bbfdd6e8ec40c16c0759825d430da8b9ac47d7b8ab4c17d7f208ee5e'
            '8797e88801616f539799a4647fc42a37caa69e689dbf4321acd588fbd054d919')
noextract=("$pkgname-$pkgver.tar.gz")

package() {
  # The tarball is the bundle tree itself, with no top-level directory.
  local _bundle="$srcdir/bundle"
  rm -rf "$_bundle"
  install -d "$_bundle"
  bsdtar -xf "$srcdir/$pkgname-$pkgver.tar.gz" -C "$_bundle"

  install -d "$pkgdir/opt/plezy"
  cp -a "$_bundle"/. "$pkgdir/opt/plezy/"
  chmod 755 "$pkgdir/opt/plezy/plezy" "$pkgdir/opt/plezy/plezy.sh"

  # plezy.sh resolves its own symlink, so the launcher lands on /opt/plezy and
  # finds the bundled libraries, gdk-pixbuf loaders and GTK modules.
  install -d "$pkgdir/usr/bin"
  ln -s /opt/plezy/plezy.sh "$pkgdir/usr/bin/plezy"

  install -Dm644 "$srcdir/com.edde746.plezy.desktop" -t "$pkgdir/usr/share/applications/"
  install -Dm644 "$srcdir/plezy.svg" -t "$pkgdir/usr/share/icons/hicolor/scalable/apps/"
  install -Dm644 "$srcdir/plezy.png" -t "$pkgdir/usr/share/icons/hicolor/1024x1024/apps/"
}
