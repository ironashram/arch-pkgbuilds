pkgbase = jellyfin-m1k-server
	pkgdesc = Jellyfin server backend with per-device profile overrides
	pkgver = 12.0
	pkgrel = 1
	url = https://jellyfin.org
	arch = x86_64
	license = GPL-2.0-or-later
	makedepends = git
	makedepends = dotnet-sdk-10.0
	makedepends = aspnet-targeting-pack-10.0
	depends = glibc
	depends = libgcc
	depends = libstdc++
	depends = aspnet-runtime-10.0
	depends = bash
	depends = sqlite
	depends = fontconfig
	depends = jellyfin-m1k-ffmpeg
	depends = jemalloc
	optdepends = jellyfin-m1k-web: to run web-app on the same machine
	optdepends = noto-fonts: for text titles in library folders
	provides = jellyfin-server=12.0
	conflicts = jellyfin-server
	options = !debug
	backup = etc/jellyfin/logging.json
	backup = etc/jellyfin/jellyfin.env
	source = jellyfin::git+https://github.com/jellyfin/jellyfin#tag=v12.0
	source = jellyfin-packaging::git+https://github.com/jellyfin/jellyfin-packaging
	source = sysusers.conf
	source = tmpfiles.conf
	source = fix-envfile-path.patch
	source = use-system-jemalloc.patch
	source = device-profile-overrides.patch
	sha256sums = SKIP
	sha256sums = SKIP
	sha256sums = SKIP
	sha256sums = SKIP
	sha256sums = SKIP
	sha256sums = SKIP
	sha256sums = SKIP

pkgname = jellyfin-m1k-server
