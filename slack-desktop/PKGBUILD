pkgname=slack-desktop
pkgver=4.52.155
pkgrel=2
pkgdesc="Slack Desktop (Beta) for Linux, running on the system Electron"
arch=('x86_64')
url="https://slack.com/downloads"
license=('custom')

# The bundled Electron 44.0.0 registers its StatusNotifierItem under a
# concatenated name+path, which every SNI host rejects, so the tray icon never
# appears (electron/electron#53213, fixed in 44.1.0 and backported to 43.5.0).
# Arch has no electron44 yet, so run on electron43, which carries the backport.
_electronver=43

depends=("electron$_electronver" 'glibc' 'libstdc++' 'libx11' 'libxkbfile'
         'libdbusmenu-glib')
optdepends=('org.freedesktop.secrets: Keyring password store support')
options=('!debug')
source=("https://downloads.slack-edge.com/desktop-releases/linux/x64/${pkgver}/${pkgname}-${pkgver}-amd64.deb"
        'slack.sh')
noextract=("${pkgname}-${pkgver}-amd64.deb")
b2sums=('91a9f799642cd910810a5778c03721d02d2bc98fb76988ae1adb5870ccca03761b37c14d7ba0a83942fb689e2f101d744eccb6292e941db77e8564b782a47e6b'
        'bfed1f29617c53e52a437203e06d1bd6fb6dc7057e329e92d1bb375a6b95646a7eaa5a9b4e49be22bc56f89b316279950ce7119f0970daf1ca12641a6751ae23')

prepare() {
    sed -i "s/@ELECTRON_VERSION@/$_electronver/" slack.sh

    mkdir -p deb
    bsdtar -O -xf "${pkgname}-${pkgver}-amd64.deb" data.tar.xz | bsdtar -C deb -xJf -

    # Silent start, and use the themed icon name rather than the hardcoded path
    sed -ri \
        -e 's|^(Exec=.+/slack)(.+)|\1 -s\2|' \
        -e 's/^Icon=.+slack\.png/Icon=slack/' \
        deb/usr/share/applications/slack.desktop
}

package() {
    install -dm755 "${pkgdir}/usr/lib/slack"
    cp -a deb/usr/lib/slack/resources deb/usr/lib/slack/locales "${pkgdir}/usr/lib/slack/"
    install -Dm644 -t "${pkgdir}/usr/lib/slack" \
        deb/usr/lib/slack/LICENSES-linux.json \
        deb/usr/lib/slack/resources.pak \
        deb/usr/lib/slack/version

    install -Dm755 slack.sh "${pkgdir}/usr/bin/slack"
    install -Dm644 -t "${pkgdir}/usr/share/applications" deb/usr/share/applications/slack.desktop
    install -Dm644 -t "${pkgdir}/usr/share/pixmaps" deb/usr/share/pixmaps/slack.png

    install -Dm644 deb/usr/lib/slack/LICENSE \
        "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
    ln -s "/usr/share/licenses/${pkgname}/LICENSE" "${pkgdir}/usr/lib/slack/LICENSE"

    find "${pkgdir}" -type d -exec chmod 755 {} +
}
